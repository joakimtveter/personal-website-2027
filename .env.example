POSTGRES_URL=postgres://postgres:postgres@127.0.0.1:5432/personal-website
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used by docker-compose to create the local database; must match POSTGRES_URL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=personal-website

# Public URL of the site, used for CORS, canonical links, sitemaps and SEO. No trailing slash
SERVER_URL=http://localhost:3000

# Validates preview requests from the admin panel
PREVIEW_SECRET=YOUR_SECRET_HERE

# Bearer token that lets an external scheduler run queued jobs (e.g. scheduled publishing)
CRON_SECRET=YOUR_CRON_SECRET_HERE
