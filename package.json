{
  "name": "personal-website-2027",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" payload build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation vite dev",
    "devsafe": "rm -rf dist && cross-env NODE_OPTIONS=--no-deprecation vite dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "oxlint --deny-warnings",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation srvx --prod --dir=. --static=dist/client --entry=dist/server/server.js",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@payloadcms/admin-bar": "4.0.0-beta.4",
    "@payloadcms/db-vercel-postgres": "4.0.0-beta.4",
    "@payloadcms/graphql": "4.0.0-beta.4",
    "@payloadcms/live-preview-react": "4.0.0-beta.4",
    "@payloadcms/plugin-form-builder": "4.0.0-beta.4",
    "@payloadcms/plugin-mcp": "4.0.0-beta.4",
    "@payloadcms/plugin-nested-docs": "4.0.0-beta.4",
    "@payloadcms/plugin-redirects": "4.0.0-beta.4",
    "@payloadcms/plugin-search": "4.0.0-beta.4",
    "@payloadcms/plugin-seo": "4.0.0-beta.4",
    "@payloadcms/richtext-lexical": "4.0.0-beta.4",
    "@payloadcms/tanstack-start": "4.0.0-beta.4",
    "@payloadcms/transformer-sharp": "4.0.0-beta.4",
    "@payloadcms/ui": "4.0.0-beta.4",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-start": "^1.169.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "10.1.0",
    "dotenv": "16.4.7",
    "escape-html": "^1.0.3",
    "graphql": "^16.8.1",
    "lucide-react": "0.563.0",
    "payload": "4.0.0-beta.4",
    "prism-react-renderer": "^2.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.4",
    "srvx": "0.11.21",
    "tailwind-merge": "^3.7.0",
    "vite": "8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "16.3.0",
    "@types/escape-html": "^1.0.4",
    "@types/node": "24.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.3",
    "@vitejs/plugin-rsc": "^0.5.21",
    "jsdom": "28.0.0",
    "oxfmt": "^0.73.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=24.22.1",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
